<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <!-- Placeholders only. Set real values locally and never commit them. -->
  <connectionStrings>
    <add name="OracleConnection"
         connectionString="Data Source=YOUR_ORACLE_HOST:1521/YOUR_SERVICE;User Id=YOUR_USER;Password=YOUR_PASSWORD;"
         providerName="Oracle.ManagedDataAccess.Client" />
    <add name="MSSQLConnection"
         connectionString="Server=YOUR_SQL_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
